# Copy this file to .env and fill in the values for your environment.
# Never commit .env — it is git-ignored.

# Active Spring profile: development | staging | production (required)
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL (required for staging and production)
DB_URL=jdbc:postgresql://localhost:5432/template_driven_document
DB_USERNAME=postgres
DB_PASSWORD=

# Redis (REDIS_HOST required for staging and production, REDIS_PASSWORD required for production)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# production only, defaults to true
REDIS_SSL_ENABLED=true
