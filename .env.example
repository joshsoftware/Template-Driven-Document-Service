# Copy this file to .env and fill in the values for your environment.
# Never commit .env — it is git-ignored.

# Active Spring profile: development | staging | production (required)
SPRING_PROFILES_ACTIVE=development
PORT=8080


# PostgreSQL (required for staging and production). Locally the host's Postgres, for bootRun and the Docker app alike.
DB_URL=jdbc:postgresql://localhost:5432/template_driven_document_service
DB_USERNAME=postgres
DB_PASSWORD=

# Redis (REDIS_HOST required for staging and production, REDIS_PASSWORD required for production).
# Locally the docker compose Redis, published on REDIS_PORT.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# production only, defaults to true
REDIS_SSL_ENABLED=true

# Document engine (optional)
TDDS_ENGINE_ZONE=Asia/Kolkata

# Local MinIO (docker compose); user 3+ chars, password 8+ chars. Defined before the S3 keys that use them.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Document storage: TDDS_STORAGE_S3_BUCKET is required (the app won't start without it)
TDDS_STORAGE_S3_BUCKET=tdds-documents
TDDS_STORAGE_S3_REGION=ap-south-1
# Development (MinIO) only; staging/production use the IAM role
TDDS_STORAGE_S3_ENDPOINT=http://localhost:9000
# Local S3 = MinIO, so the app uses the MinIO credentials above
TDDS_STORAGE_S3_ACCESS_KEY=${MINIO_ROOT_USER}
TDDS_STORAGE_S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}
