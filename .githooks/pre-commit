#!/usr/bin/env sh
# This repo sets core.hooksPath to .githooks, which replaces the global hooks folder.
# Run the global (company) pre-commit hook so its security scan still applies.

set -eu

GLOBAL_HOOKS="$(git config --global core.hooksPath || true)"

if [ -n "$GLOBAL_HOOKS" ] && [ -x "$GLOBAL_HOOKS/pre-commit" ]; then
    exec "$GLOBAL_HOOKS/pre-commit" "$@"
fi
